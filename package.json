{
  "name": "encuadre-portal-2026",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run verificar:salida",
    "preview": "astro preview",
    "lint": "eslint src/ scripts/",
    "format": "prettier --write \"src/**/*.{ts,astro,css}\" \"scripts/**/*.mjs\" \"*.{mjs,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,astro,css}\" \"scripts/**/*.mjs\" \"*.{mjs,ts}\"",
    "test": "vitest run",
    "astro": "astro",
    "check": "astro check",
    "verificar": "npm run format:check && npm run lint && npm run check && npm test",
    "verificar:salida": "node scripts/verificar-salida.mjs"
  },
  "dependencies": {
    "astro": "^7.1.6",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@types/qrcode": "^1.5.6",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
