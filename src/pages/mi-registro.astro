---
// Portal del Participante — Vista Principal
// Acceso: /mi-registro?id=ENC-XXX
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Spinner from '../components/Spinner.astro';
---
<Layout title="Mi Registro — 36 FTD Encuadre 2026" noindex={true}>
  <Header />
  <main class="portal-main" id="portal-main">
    <Spinner texto="Cargando tu registro..." />
  </main>
</Layout>

<script>
  import { escapeHTML } from '../utils/portal';
  import { renderError, renderPortal } from '../utils/vistas';

  // Configuración de endpoint para consulta de registros
  const API_BASE = import.meta.env.PUBLIC_API_BASE || 'https://encuadre-2026-api.sitio-392.workers.dev';
  const BASE_URL = import.meta.env.BASE_URL || '';

  // ── Inicio de la aplicación en el navegador ──────────────────
  async function init() {
    const id = new URLSearchParams(window.location.search).get('id') || '';
    if (!id) {
      renderError(
        'ID no proporcionado', 
        'Usa el link que recibiste en tu correo de confirmación. Busca el botón "Ver mi registro" y vuelve a intentarlo.'
      );
      return;
    }
    if (!/^[A-Za-z0-9\-]+$/.test(id) || id.length > 30) {
      renderError(
        'ID no válido',
        'El formato del identificador no es correcto. Usa el enlace original que recibiste en tu correo de confirmación.'
      );
      return;
    }
    try {
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 15_000);
      const res = await fetch(`${API_BASE}/api/participante?id=${encodeURIComponent(id)}`, { signal: controller.signal });
      clearTimeout(timeoutId);
      if (!res.ok) {
        renderError(
          'Error del servidor',
          `El servidor respondió con un error (código ${res.status}). Por favor intenta de nuevo en unos momentos.`,
          init
        );
        return;
      }
      const data = await res.json();
      if (!data.encontrado) {
        renderError(
          'Registro no encontrado', 
          `No encontramos un registro con el ID <strong>${escapeHTML(id)}</strong>. Verifica que el link sea correcto o contáctanos.`
        );
        return;
      }
      await renderPortal(data.participante, API_BASE, BASE_URL);
    } catch {
      renderError(
        'Error de conexión', 
        'No pudimos conectarnos al servidor. Por favor intenta de nuevo en unos momentos.',
        init
      );
    }
  }

  // Ejecutar al cargar el portal
  init();
</script>
