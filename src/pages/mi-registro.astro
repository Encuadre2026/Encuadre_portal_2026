---
// Portal del Participante — Vista Principal
// Acceso: /mi-registro?id=<token>
// El parámetro se llama `id` por compatibilidad con los enlaces ya enviados,
// pero su valor es el token opaco del registro, no el id_participante.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Spinner from '../components/Spinner.astro';
---
<Layout title="Mi Registro — 36 FTD Encuadre 2026" noindex={true}>
  <Header />
  <main class="portal-main" id="portal-main">
    <Spinner texto="Cargando tu registro..." />
  </main>
</Layout>

<script>
  import { renderError, renderPortal } from '../utils/vistas';
  import { ErrorApi, obtenerParticipante } from '../utils/api';

  // Configuración de endpoint para consulta de registros
  const API_BASE = import.meta.env.PUBLIC_API_BASE || 'https://encuadre-2026-api.sitio-392.workers.dev';
  const BASE_URL = import.meta.env.BASE_URL || '';

  // Forma del token del registro. Se valida antes de tocar la red para no
  // mandar al Worker cualquier cosa que venga en la URL; está documentado en
  // `SECURITY.md`. El guion no necesita escaparse dentro de una clase de
  // caracteres cuando va al final.
  const FORMA_DEL_TOKEN = /^[A-Za-z0-9-]+$/;
  const LARGO_MAXIMO_TOKEN = 30;

  const NO_ENCONTRADO =
    'No encontramos ningún registro para este enlace. Revisa que sea el enlace completo que recibiste por correo, o contáctanos si crees que es un error.';

  // ── Inicio de la aplicación en el navegador ──────────────────
  async function init() {
    // El valor del parámetro `id` es el token del registro: la credencial
    // que autoriza a ver y modificar estos datos. No se muestra en pantalla.
    const token = new URLSearchParams(window.location.search).get('id') || '';
    if (!token) {
      renderError(
        'Enlace incompleto',
        'Usa el link que recibiste en tu correo de confirmación. Busca el botón "Ver mi registro" y vuelve a intentarlo.'
      );
      return;
    }
    if (!FORMA_DEL_TOKEN.test(token) || token.length > LARGO_MAXIMO_TOKEN) {
      renderError(
        'Enlace no válido',
        'El formato del enlace no es correcto. Usa el enlace original que recibiste en tu correo de confirmación.'
      );
      return;
    }

    const controlador = new AbortController();
    const tiempoLimite = setTimeout(() => controlador.abort(), 15_000);
    try {
      const participante = await obtenerParticipante(API_BASE, token, controlador.signal);
      await renderPortal(participante, API_BASE, BASE_URL, token);
    } catch (err) {
      const fallo = err instanceof ErrorApi ? err : new ErrorApi('Error inesperado.');

      // Un enlace que no corresponde a ningún registro no es un fallo del
      // servidor y no tiene sentido ofrecer reintento: reintentarlo daría
      // siempre lo mismo.
      if (fallo.codigo === 'NO_ENCONTRADO' || fallo.status === 404) {
        renderError('Registro no encontrado', NO_ENCONTRADO);
        return;
      }

      if (fallo.esDeRed) {
        renderError(
          'Error de conexión',
          'No pudimos conectarnos al servidor. Por favor intenta de nuevo en unos momentos.',
          init
        );
        return;
      }

      // Para el resto se enseña lo que explicó el servidor, no un texto genérico.
      renderError('Error del servidor', fallo.message, init);
    } finally {
      clearTimeout(tiempoLimite);
    }
  }

  // Ejecutar al cargar el portal
  init();
</script>
