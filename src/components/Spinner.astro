---
// Componente de estado de carga inicial (spinner) con soporte para accesibilidad (a11y)
export interface Props {
  texto?: string;
}

const { texto = "Cargando tu registro..." } = Astro.props;
---
<div class="estado-loading" role="status" aria-busy="true">
  <div class="spinner" aria-hidden="true"></div>
  <p>{texto}</p>
</div>
