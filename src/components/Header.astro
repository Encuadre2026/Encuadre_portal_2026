---
// Componente de cabecera visual y logotipos oficiales de Encuadre 2026
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="portal-header">
  <div class="header-brand">
    <img
      src={`${base}/logo_3.webp`}
      alt="36 Encuentro"
      class="logo-header"
      width="100"
      height="44"
      loading="eager"
    />
    <div class="portal-header-sep"></div>
    {/*
      WebP sin pérdida de 538×120 (9,5 KB) en lugar del PNG de 3174×708 (38 KB).
      Es el mismo dibujo: el original tenía nueve colores y venía a resolución de
      impresión de cartel para pintarse a 28 px de alto. El PNG se conserva en
      `public/` porque sigue siendo la imagen de `og:image`, y ahí los
      rastreadores de redes sociales no aceptan WebP de forma fiable.
    */}
    <img
      src={`${base}/logo_futurologia_encuadre.webp`}
      alt="Futurología Encuadre"
      class="logo-titulo-nav"
      width="140"
      height="28"
      loading="eager"
    />
    <div class="portal-header-text-block">
      <div class="portal-header-label">Portal del Participante</div>
      <div class="portal-header-sub">36 FTD Encuadre 2026</div>
    </div>
  </div>
</header>
