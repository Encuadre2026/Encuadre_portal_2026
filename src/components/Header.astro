---
// Componente de cabecera visual y logotipos oficiales de Encuadre 2026
---
<header class="portal-header">
  <div class="header-brand">
    <img src={import.meta.env.BASE_URL + "/logo_3.webp"} alt="36 Encuentro" class="logo-header" width="100" height="44" loading="eager" />
    <div class="portal-header-sep"></div>
    <img src={import.meta.env.BASE_URL + "/logo_futurologia_encuadre.png"} alt="Futurología Encuadre" class="logo-titulo-nav" width="140" height="28" loading="eager" />
    <div class="portal-header-text-block">
      <div class="portal-header-label">Portal del Participante</div>
      <div class="portal-header-sub">36 FTD Encuadre 2026</div>
    </div>
  </div>
</header>
